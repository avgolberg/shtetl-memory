  stages:
  - title: Strange case on the door
    lines:
    - "\u25CF There is a small case attached to the doorframe."
  - title: Strange case on the door
    lines:
    - "\u25CF It is placed on the doorpost in Jewish homes."
  - title: Mezuzah
    lines:
    - "\u25CF It is called a mezuzah."
    - "\u25CF It marks the home as a Jewish home."
    - "\u25CF It connects daily life with tradition."
