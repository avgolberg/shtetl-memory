  m_Script: {fileID: 11500000, guid: 5af86c06a1cd5294e909c2ee75d2c673, type: 3}
  m_Name: Halyna NPCDialogue  Part1
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  npcName: Halyna
  npcPortrait: {fileID: -6471082416391893753, guid: 53d5f5efd048d2d4081b29c56deb11a6, type: 3}
  dialogueLines:
  - "My friend turns seventy today. Imagine that!"
  - "I promised her a bouquet of wildflowers."
  - "Flowers are better than cake. Easier on the teeth!"
  - "Wildflowers grow all along this street."
  - "Would you help me pick a few?"
  - "All right. I'll be here."
  - "Thank you, dear! While you pick them..."
  - "I'll look for something inside. Your photo reminded me."
  - "Flowers from the street smell better than shop ones."
  - "Oh, you did it! Beautiful. She'll love them."
  - "And look, I found my husband's old box."
  - "Now, about this house..."
