  m_Script: {fileID: 11500000, guid: 5af86c06a1cd5294e909c2ee75d2c673, type: 3}
  m_Name: Halyna NPCDialogue  Part2
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  npcName: Halyna
  npcPortrait: {fileID: -6471082416391893753, guid: 53d5f5efd048d2d4081b29c56deb11a6, type: 3}
  dialogueLines:
  - "A Jewish family lived here before us."
  - "They were killed during the war."
  - "I heard very little about them."
  - "I don't even know their family name."
  - "My grandmother said they always shopped at the market on Fridays."
  - "After the war, the authorities let my family live here."
  - "We had many children, and my father worked at a factory."
  - "Only an old wardrobe was left from the old family."
  - "I have a key somewhere, but I never opened it."
  - "It must be in that box, with all the other keys."
  - "But it's such a mess! Could you find the old keys?"
  - "Thank you. My eyes are not what they used to be."
  - "Did you find the old keys, dear?"
  - "Yes, these are the old keys!"
  - "Come inside, dear. Let's see what they open."
  - "The door is open. I'll wait here in the garden."
  autoProgressLines: 01010101010101010101010101010101
