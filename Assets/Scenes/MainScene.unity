  pages:
  - image: {fileID: 21300000, guid: 719e1fc6a492be846996da90169e606a, type: 3}
    title: Old drawer
    text: The drawer is open. Inside are old photos and papers.
    imageText: 
    journalTopicId: 
    journalStage: 0
    questObjectiveId: 
    startsQuest: {fileID: 0}
  - image: {fileID: 21300000, guid: 567b377ee65a6ae4485c2c0ecd3f631e, type: 3}
    title: Family photo
    text: A big Jewish family sits at the table at home. Behind them, one small square
      of the wall was left unfinished. Why?
    imageText: 
    journalTopicId: family_photo
    journalStage: 0
    questObjectiveId: 
    startsQuest: {fileID: 0}
  - image: {fileID: 21300000, guid: fd1a3b542e1700249b44bab6bdd1366a, type: 3}
    title: School photo
    text: 'An old class photo: girls and boys with their teacher. Did great-grandma
      study at this school?'
    imageText: 
    journalTopicId: school_photo
    journalStage: 0
    questObjectiveId: 
    startsQuest: {fileID: 11400000, guid: a0feb209886d4e4d9dbb658931b055da, type: 2}
  - image: {fileID: 21300000, guid: 20da122079563114dbaf425e6cf848d7, type: 3}
    title: Invitation
    text: An old invitation to a wedding in the synagogue. Where was the synagogue?
    imageText: 'With joy, we invite you

      to celebrate the marriage

      of
      Rivka and David.


      Ladanivka Synagogue

      1937'
    journalTopicId: wedding_invitation
    journalStage: 0
    questObjectiveId: house_finds_seen
    startsQuest: {fileID: 11400000, guid: 6ed39c49eea74bb8b8dbba0851e62e27, type: 2}
